config interface 'loopback'
        option device 'lo'
        option proto 'static'
        option ipaddr '127.0.0.1'
        option netmask '255.0.0.0'

# Single VLAN-aware bridge.
config device
        option name 'br-lan'
        option type 'bridge'
        option ipv6 '0'
        option bridge_empty '1'
        option stp '1'
        option igmp_snooping '0'
        list ports 'eth0'
        list ports 'eth1'
        list ports 'eth2'
        list ports 'eth3'
        list ports 'eth4'
        list ports 'eth5'
        list ports 'eth6'
        list ports 'eth7'
        list ports 'eth8'

config interface 'lan'
        option device 'br-lan.100'
        option proto 'static'
        option ipaddr '192.168.1.1'
        option netmask '255.255.255.0'
        option ipv6 '0'
        option delegate '0'

config interface 'guest'
        option device 'br-lan.200'
        option proto 'static'
        option ipaddr '192.168.2.1'
        option netmask '255.255.255.0'
        option ipv6 '0'
        option delegate '0'

config interface 'iot'
        option device 'br-lan.300'
        option proto 'static'
        option ipaddr '192.168.3.1'
        option netmask '255.255.255.0'
        option ipv6 '0'
        option delegate '0'

config bridge-vlan
        option device 'br-lan'
        option vlan '100'
        list ports 'eth0'
        list ports 'eth1'
		list ports 'eth2'
        list ports 'eth3'
        list ports 'eth8:t'

config bridge-vlan
        option device 'br-lan'
        option vlan '200'
		list ports 'eth4'
        list ports 'eth5'
        list ports 'eth8:t'

config bridge-vlan
        option device 'br-lan'
        option vlan '300'
        list ports 'eth6'
        list ports 'eth7'
        list ports 'eth8:t'



