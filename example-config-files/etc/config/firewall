###############################################################################
# Lock down router defaults and force implied deny / explicit allow only
###############################################################################

config defaults
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option synflood_protect '1'


###############################################################################
# Zones
###############################################################################

config zone
	option name 'lan'
	option family 'ipv4'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	list network 'lan'

config zone
	option name 'guest'
	option family 'ipv4'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	list network 'guest'

config zone
	option name 'iot'
	option family 'ipv4'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	list network 'iot'

config zone
	option name 'wan'
	option family 'ipv4'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	option masq '1'
	option mtu_fix '1'
	list network 'wan'


###############################################################################
# Internet forwarding
###############################################################################

config forwarding
	option src 'lan'
	option dest 'wan'

config forwarding
	option src 'guest'
	option dest 'wan'

config forwarding
	option src 'iot'
	option dest 'wan'


###############################################################################
# WAN Multicast guardrails
###############################################################################

config rule
	option name 'Deny-WAN-Multicast-to-Router'
	option family 'ipv4'
	option src 'wan'
	option proto 'udp'
	option dest_ip '224.0.0.0/4'
	option target 'DROP'

config rule
	option name 'Deny-Router-Multicast-to-WAN'
	option family 'ipv4'
	option dest 'wan'
	option proto 'udp'
	option dest_ip '224.0.0.0/4'
	option target 'DROP'


###############################################################################
# DHCP
###############################################################################

# Keep this rule if WAN can use DHCP. If WAN is strictly PPPoE, it can be removed.
config rule
	option name 'Allow-DHCP-WAN'
	option family 'ipv4'
	option src 'wan'
	option proto 'udp'
	option dest_port '68'
	option target 'ACCEPT'

config rule
	option name 'Allow-DHCP-LAN'
	option family 'ipv4'
	option src 'lan'
	option proto 'udp'
	option src_port '68'
	option dest_port '67'
	option target 'ACCEPT'

config rule
	option name 'Allow-DHCP-GUEST'
	option family 'ipv4'
	option src 'guest'
	option proto 'udp'
	option src_port '68'
	option dest_port '67'
	option target 'ACCEPT'

config rule
	option name 'Allow-DHCP-IOT'
	option family 'ipv4'
	option src 'iot'
	option proto 'udp'
	option src_port '68'
	option dest_port '67'
	option target 'ACCEPT'


###############################################################################
# DNS
###############################################################################

config rule
	option name 'Allow-DNS-LAN'
	option family 'ipv4'
	option src 'lan'
	list proto 'udp'
	list proto 'tcp'
	option dest_port '53'
	option target 'ACCEPT'

config rule
	option name 'Allow-DNS-GUEST'
	option family 'ipv4'
	option src 'guest'
	list proto 'udp'
	list proto 'tcp'
	option dest_port '53'
	option target 'ACCEPT'

config rule
	option name 'Allow-DNS-IOT'
	option family 'ipv4'
	option src 'iot'
	list proto 'udp'
	list proto 'tcp'
	option dest_port '53'
	option target 'ACCEPT'


###############################################################################
# Router HTTP and SSH management
###############################################################################

config rule
	option name 'Allow-Luci-SSH-LAN'
	option family 'ipv4'
	option src 'lan'
	option proto 'tcp'
	option dest_port '22 80'
	option target 'ACCEPT'


###############################################################################
# mDNS / Bonjour to local Avahi reflector
###############################################################################

config rule
	option name 'Allow-mDNS-LAN'
	option family 'ipv4'
	option src 'lan'
	option proto 'udp'
	option dest_ip '224.0.0.251'
	option dest_port '5353'
	option target 'ACCEPT'

config rule
	option name 'Allow-mDNS-GUEST'
	option family 'ipv4'
	option src 'guest'
	option proto 'udp'
	option dest_ip '224.0.0.251'
	option dest_port '5353'
	option target 'ACCEPT'

config rule
	option name 'Allow-mDNS-IOT'
	option family 'ipv4'
	option src 'iot'
	option proto 'udp'
	option dest_ip '224.0.0.251'
	option dest_port '5353'
	option target 'ACCEPT'


###############################################################################
# Sonos controllers (trusted) -> IoT speakers
# Sonos static reservation range: 192.168.3.16/28
###############################################################################

config rule
	option name 'Allow-Sonos-from-LAN'
	option family 'ipv4'
	option src 'lan'
	option dest 'iot'
	option dest_ip '192.168.3.16/28'
	option proto 'all'
	option target 'ACCEPT'

config rule
	option name 'Allow-Sonos-from-GUEST'
	option family 'ipv4'
	option src 'guest'
	option dest 'iot'
	option dest_ip '192.168.3.16/28'
	option proto 'all'
	option target 'ACCEPT'


###############################################################################
# SSDP multicast forwarding for SMCRoute
###############################################################################

config rule
	option name 'SSDP-LAN-to-IoT'
	option family 'ipv4'
	option src 'lan'
	option dest 'iot'
	option proto 'udp'
	option dest_ip '239.255.255.250'
	option dest_port '1900'
	option target 'ACCEPT'

config rule
	option name 'SSDP-Guest-to-IoT'
	option family 'ipv4'
	option src 'guest'
	option dest 'iot'
	option proto 'udp'
	option dest_ip '239.255.255.250'
	option dest_port '1900'
	option target 'ACCEPT'

config rule
	option name 'SSDP-IoT-to-LAN'
	option family 'ipv4'
	option src 'iot'
	option dest 'lan'
	option proto 'udp'
	option dest_ip '239.255.255.250'
	option dest_port '1900'
	option target 'ACCEPT'

config rule
	option name 'SSDP-IoT-to-Guest'
	option family 'ipv4'
	option src 'iot'
	option dest 'guest'
	option proto 'udp'
	option dest_ip '239.255.255.250'
	option dest_port '1900'
	option target 'ACCEPT'


###############################################################################
# Sonos device-initiated traffic (IoT speakers -> trusted networks)
###############################################################################

config rule
	option name 'Allow-Sonos-TCP-IoT-to-LAN'
	option family 'ipv4'
	option src 'iot'
	option dest 'lan'
	list src_ip '192.168.3.16/28'
	option proto 'tcp'
	option dest_port '3400'
	option target 'ACCEPT'

config rule
	option name 'Allow-Sonos-TCP-IoT-to-GUEST'
	option family 'ipv4'
	option src 'iot'
	option dest 'guest'
	list src_ip '192.168.3.16/28'
	option proto 'tcp'
	option dest_port '3400'
	option target 'ACCEPT'

config rule
	option name 'Sonos-UDP-replies-IoT-to-LAN'
	option family 'ipv4'
	option src 'iot'
	option dest 'lan'
	list src_ip '192.168.3.16/28'
	option dest_ip '192.168.1.0/24'
	option proto 'udp'
	option dest_port '1024-65535'
	option target 'ACCEPT'

config rule
	option name 'Sonos-UDP-replies-IoT-to-Guest'
	option family 'ipv4'
	option src 'iot'
	option dest 'guest'
	list src_ip '192.168.3.16/28'
	option dest_ip '192.168.2.0/24'
	option proto 'udp'
	option dest_port '1024-65535'
	option target 'ACCEPT'


###############################################################################
# Optional router-hosted Samba music library
###############################################################################

config rule
	option name 'Allow-SMB-LAN-to-Router'
	option family 'ipv4'
	option src 'lan'
	option proto 'tcp'
	option dest_port '445'
	option target 'ACCEPT'

config rule
	option name 'Allow-SMB-GUEST-to-Router'
	option family 'ipv4'
	option src 'guest'
	option proto 'tcp'
	option dest_port '445'
	option target 'ACCEPT'

config rule
	option name 'Allow-SMB-IOT-to-Router'
	option family 'ipv4'
	option src 'iot'
	option proto 'tcp'
	option dest_port '445'
	option target 'ACCEPT'


###############################################################################
# Optional Windows Network discovery browsing on specific interfaces
###############################################################################

config rule
	option name 'Allow-WSD-LLMNR-LAN'
	option family 'ipv4'
	option src 'lan'
	list proto 'udp'
	list proto 'tcp'
	option dest_port '3702 5355'
	option target 'ACCEPT'

config rule
	option name 'Allow-WSD-LLMNR-GUEST'
	option family 'ipv4'
	option src 'guest'
	list proto 'udp'
	list proto 'tcp'
	option dest_port '3702 5355'
	option target 'ACCEPT'

config rule
	option name 'Allow-WSD-LLMNR-IOT'
	option family 'ipv4'
	option src 'iot'
	list proto 'udp'
	list proto 'tcp'
	option dest_port '3702 5355'
	option target 'ACCEPT'

###############################################################################
# ICMP to router
# TCP dumps occasionally show Sonos using ICMP (maybe for network quality?)
# Sonos works without this, but its also useful to be able to ping your network!
###############################################################################

config rule
	option name 'Allow-ICMP-LAN-to-Router'
	option family 'ipv4'
	option src 'lan'
	option proto 'icmp'
	option target 'ACCEPT'

config rule
	option name 'Allow-ICMP-GUEST-to-Router'
	option family 'ipv4'
	option src 'guest'
	option proto 'icmp'
	option target 'ACCEPT'

config rule
	option name 'Allow-ICMP-IOT-to-Router'
	option family 'ipv4'
	option src 'iot'
	option proto 'icmp'
	option target 'ACCEPT'


###############################################################################
# ICMP between internal networks
###############################################################################

config rule
	option name 'Allow-ICMP-LAN-to-Internal'
	option family 'ipv4'
	option src 'lan'
	option dest '*'
	option proto 'icmp'
	list dest_ip '192.168.2.0/24'
	list dest_ip '192.168.3.0/24'
	option target 'ACCEPT'

config rule
	option name 'Allow-ICMP-GUEST-to-Internal'
	option family 'ipv4'
	option src 'guest'
	option dest '*'
	option proto 'icmp'
	list dest_ip '192.168.1.0/24'
	list dest_ip '192.168.3.0/24'
	option target 'ACCEPT'

config rule
	option name 'Allow-ICMP-IOT-to-Internal'
	option family 'ipv4'
	option src 'iot'
	option dest '*'
	option proto 'icmp'
	list dest_ip '192.168.1.0/24'
	list dest_ip '192.168.2.0/24'
	option target 'ACCEPT'

